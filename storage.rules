rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Capacidades assinadas pelo servidor; ausentes = negar. Não confiar em
    // metadados enviados pelo navegador. Ativar somente após provisionar o bucket.
    function acesso(area) {
      return request.auth != null
        && request.auth.token.erp_storage is map
        && request.auth.token.erp_storage[area] == true;
    }
    function imagem() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Foto de prova da pesagem do granel (manipulacao.html). Só imagem, e
    // menor que o documento comercial: é foto de celular, não anexo de proposta.
    match /manipulacao/{lote}/{arquivo} {
      allow read: if acesso('manipulacao');
      allow create: if acesso('manipulacao') && request.resource.size < 10 * 1024 * 1024 && imagem();
      allow update, delete: if false;
    }

    // Fotos das análises da Qualidade (laudo de insumo/embalagem/PA, bulk e RNC):
    // até 6 por registro, só imagem, menor que 10 MB. Um nível de pasta:
    // qualidade/{contexto}_{chave}/{arquivo} (shared/fotos-qualidade.js).
    match /qualidade/{pasta}/{arquivo} {
      allow read: if acesso('qualidade');
      allow create: if acesso('qualidade') && request.resource.size < 10 * 1024 * 1024 && imagem();
      allow update, delete: if false;
    }

    // Logo do cliente para a etiqueta de caixa (Cadastros › Clientes,
    // shared/etiqueta-caixa.js): PNG reduzido no navegador, até 2 MB.
    match /clientes_logo/{arquivo} {
      allow read: if acesso('cadastros');
      allow create, update: if acesso('cadastros') && request.resource.size < 2 * 1024 * 1024 && imagem();
      allow delete: if false;
    }

    match /comercial/{documento}/{arquivo} {
      allow read: if acesso('comercial');
      allow create: if acesso('comercial')
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
          || imagem()
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType == 'application/msword');
      allow update, delete: if false;
    }
  }
}
