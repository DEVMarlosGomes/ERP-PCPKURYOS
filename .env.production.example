# Copie para /opt/kuryos/config/.env.production na VPS e aplique chmod 600.
# Nunca versionar o arquivo preenchido. Valores VITE_* são públicos; os demais
# segredos existem somente no backend. Este primeiro deploy não cria banco novo.

# Identificação da versão e imagens fixas.
APP_VERSION=<COMMIT_GIT_VALIDADO>
NODE_IMAGE=node:24.17.0-alpine3.23
CADDY_IMAGE=caddy:2.10.2-alpine

# Domínio público, sem https:// nem barra final. Ex.: erp.empresa.com.br
ERP_DOMAIN=<DOMINIO_DO_ERP>
ACME_EMAIL=<EMAIL_TECNICO_PARA_CERTIFICADO>

# Firebase ainda utilizado: RTDB, Auth, Storage e credencial administrativa do servidor.
GCLOUD_PROJECT=erpkuryos
FIREBASE_DATABASE_URL=https://erpkuryos-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=erpkuryos.firebasestorage.app
RTDB_INSTANCE=erpkuryos-default-rtdb
FIREBASE_SERVICE_ACCOUNT_FILE=/opt/kuryos/secrets/firebase-service-account.json

# Chaves exclusivas do servidor. Gere valores longos e aleatórios.
OPS_API_KEY=<SEGREDO_ALEATORIO>
PEDIDOS_API_KEY=<SEGREDO_ALEATORIO>

# E-mails automáticos (avisos, faturamento com PDF, resumos) pelo Resend. Com a chave
# preenchida, todos saem pelo Resend; vazia, saem pelo Microsoft Graph abaixo.
# RESEND_FROM precisa ser de um domínio verificado no painel do Resend (DNS SPF/DKIM).
RESEND_API_KEY=<CHAVE_RESEND_re_...>
RESEND_FROM="Kuryos ERP <nao-responder@kuryoserp.com.br>"
RESEND_REPLY_TO=<EMAIL_QUE_RECEBE_AS_RESPOSTAS>

# Microsoft Graph (Outlook da Kuryos). Continua necessário para o RASCUNHO de cotação
# em Compras; os avisos só usam o Graph se RESEND_API_KEY estiver vazia.
MS_GRAPH_TENANT_ID=<TENANT_MICROSOFT>
MS_GRAPH_CLIENT_ID=<CLIENT_ID_MICROSOFT>
MS_GRAPH_CLIENT_SECRET=<SEGREDO_MICROSOFT>
MS_GRAPH_SENDER_EMAIL=<EMAIL_REMETENTE>

# Operação. Em produção normal ambos devem ser 0.
DISABLE_TRIGGERS=0
DISABLE_SCHEDULE=0
BACKUP_DIR=/opt/kuryos/backups

# Backup externo criptografado via Restic/S3 compatível. Preencher antes de ativar o cron.
RESTIC_REPOSITORY=s3:<ENDPOINT_S3>/<BUCKET>/<PREFIXO>
RESTIC_PASSWORD=<SENHA_FORTE_DO_REPOSITORIO_RESTIC>
AWS_ACCESS_KEY_ID=<ACCESS_KEY_BACKUP>
AWS_SECRET_ACCESS_KEY=<SECRET_KEY_BACKUP>
AWS_DEFAULT_REGION=us-east-1

# Configuração pública usada apenas ao recompilar o CRM fora do Docker.
VITE_FIREBASE_API_KEY=<CHAVE_PUBLICA_WEB_FIREBASE>
VITE_FIREBASE_AUTH_DOMAIN=erpkuryos.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://erpkuryos-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=erpkuryos
VITE_FIREBASE_STORAGE_BUCKET=erpkuryos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<ID_PUBLICO_FIREBASE>
VITE_FIREBASE_APP_ID=<APP_ID_PUBLICO_FIREBASE>
VITE_FUNCTIONS_ORIGIN=https://<DOMINIO_DO_ERP>/api

