{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/static/js/9752.048286cd.chunk.js",
      "destination": "/static/js/9752.masterintegration20261008.chunk.js"
    },
    {
      "source": "/crm1",
      "destination": "/crm-app"
    },
    {
      "source": "/crm2",
      "destination": "/crm-app"
    },
    {
      "source": "/crm3",
      "destination": "/crm-app"
    },
    {
      "source": "/crm-admin",
      "destination": "/crm-app"
    },
    {
      "source": "/kickoffs",
      "destination": "/crm-app"
    },
    {
      "source": "/contratos",
      "destination": "/crm-app"
    },
    {
      "source": "/pd",
      "destination": "/crm-app"
    },
    {
      "source": "/kickoff/:path*",
      "destination": "/crm-app"
    },
    {
      "source": "/crm/:path*",
      "destination": "/crm-app"
    },
    {
      "source": "/pd/:path*",
      "destination": "/crm-app"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/shared/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/auth_check.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/crm1.html",
      "destination": "/crm1",
      "permanent": true
    },
    {
      "source": "/crm2.html",
      "destination": "/crm2",
      "permanent": true
    },
    {
      "source": "/crm3.html",
      "destination": "/crm3",
      "permanent": true
    },
    {
      "source": "/crm-admin.html",
      "destination": "/crm-admin",
      "permanent": true
    },
    {
      "source": "/kickoffs.html",
      "destination": "/kickoffs",
      "permanent": true
    },
    {
      "source": "/contratos.html",
      "destination": "/contratos",
      "permanent": true
    },
    {
      "source": "/pd.html",
      "destination": "/pd",
      "permanent": true
    }
  ]
}
